<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>atlas_walking_demo</name>
  <version>0.1.0</version>
  <description>
    Statically-stable, keyboard-controlled stepping demo for Atlas -- new
    tutorial content built on top of the ported drcsim packages, not a
    port of anything from the original repo.
  </description>
  <maintainer email="maintainer@example.com">Open Source Robotics Foundation</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>atlas_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>osrf_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>ament_cmake_copyright</test_depend>
  <test_depend>ament_cmake_flake8</test_depend>
  <test_depend>ament_cmake_pep257</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
