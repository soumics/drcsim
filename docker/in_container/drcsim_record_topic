#!/usr/bin/env python3
"""
Record a sensor_msgs/Image topic to an MP4.

usage: drcsim_record_topic TOPIC OUT.mp4 [FPS] [wall|sim]   (SIGINT/SIGTERM stops)
- sim (for sensors rendered at FPS Hz of simulation time): every frame is
  written once, so the video plays the simulation at true speed however
  fast or slow it ran.
Also writes OUT.t0: the first frame's header stamp (s).
- wall (default): the newest frame is written every 1/FPS s of wall time
  (repeated if none arrived), to stay in step with screen recordings.
"""
import signal
import subprocess
import sys
import threading
import time

import rclpy
from rclpy.qos import qos_profile_sensor_data
from sensor_msgs.msg import Image

topic, out = sys.argv[1], sys.argv[2]
fps = float(sys.argv[3]) if len(sys.argv) > 3 else 25.0
mode = sys.argv[4] if len(sys.argv) > 4 else 'wall'
rclpy.init()
node = rclpy.create_node('record_topic')
latest = {}
fresh = threading.Event()


def on_image(msg):
    latest['m'] = msg
    fresh.set()


node.create_subscription(Image, topic, on_image, qos_profile_sensor_data)
threading.Thread(target=rclpy.spin, args=(node,), daemon=True).start()
while 'm' not in latest:
    time.sleep(0.05)
first = latest['m']
# The first frame's stamp (simulation time for gz sensors), so a recording
# can be synced to other events: OUT.t0.
with open(out + '.t0', 'w') as f:
    f.write(f'{first.header.stamp.sec + first.header.stamp.nanosec * 1e-9:.3f}\n')
encoding = {'rgb8': 'rgb24', 'bgr8': 'bgr24'}[first.encoding]
ffmpeg = subprocess.Popen(
    ['ffmpeg', '-loglevel', 'error', '-y', '-f', 'rawvideo', '-pix_fmt', encoding,
     '-s', f'{first.width}x{first.height}', '-framerate', str(fps), '-i', '-',
     '-c:v', 'libx264', '-preset', 'veryfast', '-crf', '18', '-pix_fmt', 'yuv420p', out],
    stdin=subprocess.PIPE)
running = [True]
for sig in (signal.SIGINT, signal.SIGTERM):
    signal.signal(sig, lambda *_: running.__setitem__(0, False))
start, frames = time.monotonic(), 0
while running[0]:
    if mode == 'sim':
        if not fresh.wait(timeout=0.2):
            continue
        fresh.clear()
    ffmpeg.stdin.write(bytes(latest['m'].data))
    frames += 1
    if mode == 'wall':
        delay = start + frames / fps - time.monotonic()
        if delay > 0:
            time.sleep(delay)
ffmpeg.stdin.close()
ffmpeg.wait()
print(f'{out}: {frames} frames')
