#!/bin/bash
# Screenshot Gazebo and RViz views of the running simulation on a private
# virtual display (Xvfb :99), without touching the real screen.
#   drcsim_snapshot OUT_DIR [VIEW ...]
# Views: overview, left_hand, right_hand, front (default: all four). Writes
# OUT_DIR/gazebo_<view>.png and OUT_DIR/rviz_<view>.png.
set -e
OUT="${1:-/tmp/snapshots}"; shift || true
VIEWS="${*:-overview left_hand right_hand front}"
mkdir -p "$OUT"
export DISPLAY=:99
unset __NV_PRIME_RENDER_OFFLOAD __GLX_VENDOR_LIBRARY_NAME
export LIBGL_ALWAYS_SOFTWARE=1
if ! pgrep -f "Xvfb :99" > /dev/null; then
  Xvfb :99 -screen 0 1600x1000x24 > /tmp/xvfb.log 2>&1 &
  sleep 2
fi
RVIZ_BASE="$(ros2 pkg prefix drcsim_gazebo)/share/drcsim_gazebo/config/atlas.rviz"

# name: gazebo camera (x y z, looking at tx ty tz) | rviz focal point x y z, distance, yaw, pitch
declare -A GZ_EYE GZ_AT RV_FOCUS RV_DIST RV_YAW RV_PITCH
GZ_EYE[overview]="2.6 -2.2 1.6";   GZ_AT[overview]="0 0 0.9"
GZ_EYE[left_hand]="0.9 1.3 1.6";   GZ_AT[left_hand]="0.1 0.95 1.3"
GZ_EYE[right_hand]="0.9 -1.3 1.6"; GZ_AT[right_hand]="0.1 -0.95 1.3"
GZ_EYE[front]="1.9 0.35 1.55";     GZ_AT[front]="0 0 1.25"
RV_FOCUS[overview]="0 0 -0.1";     RV_DIST[overview]=3.2;   RV_YAW[overview]=0.8;  RV_PITCH[overview]=0.3
RV_FOCUS[left_hand]="0.1 0.95 0.4"; RV_DIST[left_hand]=0.9; RV_YAW[left_hand]=0.9; RV_PITCH[left_hand]=0.5
RV_FOCUS[right_hand]="0.1 -0.95 0.4"; RV_DIST[right_hand]=0.9; RV_YAW[right_hand]=-0.9; RV_PITCH[right_hand]=0.5
RV_FOCUS[front]="0.1 0 0.35";      RV_DIST[front]=2.0;      RV_YAW[front]=0.15;    RV_PITCH[front]=0.2

grab() {  # grab OUTFILE
  python3 -c "
from PIL import ImageGrab
im = ImageGrab.grab(xdisplay=':99')
box = im.convert('L').point(lambda v: 255 if v > 8 else 0).getbbox()
(im.crop(box) if box else im).save('$1')"
}

# Ogre 1 for the GUI here: Ogre-Next (ogre2) initialises through Mesa EGL,
# which segfaults on Xvfb in this image (driCreateNewScreen3). Ogre 1 uses
# GLX and renders diffuse colours only (no PBR sheen) -- use drcsim_gui on
# a real display for the full look.
gz sim -g -v 1 --render-engine-gui ogre > /tmp/snap_gz.log 2>&1 &
GZ_PID=$!
sleep 25  # software rendering: the GUI needs a while to load the scene
for view in $VIEWS; do
  read -r ex ey ez <<< "${GZ_EYE[$view]}"; read -r tx ty tz <<< "${GZ_AT[$view]}"
  # Orientation that looks from the eye at the target (yaw about z, pitch about y).
  python3 - "$ex" "$ey" "$ez" "$tx" "$ty" "$tz" > /tmp/snap_req.txt <<'EOF'
import math, sys
ex, ey, ez, tx, ty, tz = map(float, sys.argv[1:])
dx, dy, dz = tx - ex, ty - ey, tz - ez
yaw, pitch = math.atan2(dy, dx), -math.atan2(dz, math.hypot(dx, dy))
cy, sy, cp, sp = math.cos(yaw / 2), math.sin(yaw / 2), math.cos(pitch / 2), math.sin(pitch / 2)
print(f'pose: {{position: {{x: {ex}, y: {ey}, z: {ez}}}, orientation: '
      f'{{x: {-sy * sp}, y: {cy * sp}, z: {sy * cp}, w: {cy * cp}}}}}')
EOF
  gz service -s /gui/move_to/pose --reqtype gz.msgs.GUICamera --reptype gz.msgs.Boolean \
    --timeout 5000 --req "$(cat /tmp/snap_req.txt)" > /dev/null
  sleep 6
  grab "$OUT/gazebo_$view.png"
done
kill $GZ_PID 2>/dev/null || true
sleep 2

for view in $VIEWS; do
  read -r fx fy fz <<< "${RV_FOCUS[$view]}"
  cfg="/tmp/snap_$view.rviz"
  sed -e "s/Distance: .*/Distance: ${RV_DIST[$view]}/" \
      -e "s/Focal Point: .*/Focal Point: {X: $fx, Y: $fy, Z: $fz}/" \
      -e "s/Yaw: .*/Yaw: ${RV_YAW[$view]}/" -e "s/Pitch: .*/Pitch: ${RV_PITCH[$view]}/" \
      "$RVIZ_BASE" > "$cfg"
  rviz2 -d "$cfg" --ros-args -p use_sim_time:=true > /tmp/snap_rviz.log 2>&1 &
  RV_PID=$!
  sleep 12
  grab "$OUT/rviz_$view.png"
  kill $RV_PID 2>/dev/null || true
  sleep 2
done
ls -1 "$OUT"
