<?xml version="1.0"?>
<sdf version="1.9">
  <world name="door_test">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>

    <model name="door_test_model">
      <pose>0 0 0 0 0 0</pose>
      <static>false</static>

      <link name="frame">
        <inertial>
          <mass>1000</mass>
          <inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia>
        </inertial>
      </link>

      <link name="door_link">
        <pose>1 0 0 0 0 0</pose>
        <inertial>
          <mass>5</mass>
          <inertia><ixx>0.5</ixx><iyy>0.5</iyy><izz>0.1</izz></inertia>
        </inertial>
      </link>

      <link name="handle_link">
        <pose>1.4 0 0 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia>
        </inertial>
      </link>

      <joint name="door_joint" type="revolute">
        <parent>frame</parent>
        <child>door_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-1.5708</lower><upper>1.5708</upper></limit>
        </axis>
      </joint>

      <joint name="handle_joint" type="revolute">
        <parent>door_link</parent>
        <child>handle_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-0.5</lower><upper>0.5</upper></limit>
        </axis>
      </joint>

      <plugin filename="DRCBuildingPlugin"
              name="drcsim_gazebo_plugins::DRCBuildingPlugin">
        <door_joint>door_joint</door_joint>
        <handle_joint>handle_joint</handle_joint>
      </plugin>
    </model>
  </world>
</sdf>
