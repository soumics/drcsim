<?xml version="1.0"?>
<sdf version="1.9">
  <world name="drc_vehicle_ros_plugin_test">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>

    <!-- Same minimal vehicle model as drcsim_gazebo_plugins' own
         vehicle_test.sdf (11 joints DRCVehiclePlugin::Configure requires),
         just with DRCVehicleROSPlugin (this package) as the plugin
         instead of the plain DRCVehiclePlugin -- DRCVehicleROSPlugin
         subclasses it and calls its Configure()/PreUpdate() directly. -->
    <model name="vehicle_test_model">
      <pose>0 0 0.5 0 0 0</pose>

      <link name="chassis">
        <inertial>
          <mass>1000</mass>
          <inertia><ixx>100</ixx><iyy>100</iyy><izz>100</izz></inertia>
        </inertial>
        <collision name="chassis_collision">
          <geometry><box><size>2 1 0.4</size></box></geometry>
        </collision>
      </link>

      <joint name="chassis_to_world" type="fixed">
        <parent>world</parent>
        <child>chassis</child>
      </joint>

      <link name="gas_pedal_link">
        <pose>1 -0.3 0 0 0 0</pose>
        <inertial><mass>0.1</mass>
          <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
        </inertial>
      </link>
      <joint name="gas_pedal_joint" type="prismatic">
        <parent>chassis</parent>
        <child>gas_pedal_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>0</lower><upper>0.05</upper></limit>
        </axis>
      </joint>

      <link name="brake_pedal_link">
        <pose>1 0 0 0 0 0</pose>
        <inertial><mass>0.1</mass>
          <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
        </inertial>
      </link>
      <joint name="brake_pedal_joint" type="prismatic">
        <parent>chassis</parent>
        <child>brake_pedal_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>0</lower><upper>0.05</upper></limit>
        </axis>
      </joint>

      <link name="steering_wheel_link">
        <pose>1 0.3 0.3 0 0 0</pose>
        <inertial><mass>0.5</mass>
          <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia>
        </inertial>
      </link>
      <joint name="steering_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>steering_wheel_link</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit><lower>-6.28</lower><upper>6.28</upper></limit>
        </axis>
      </joint>

      <link name="hand_brake_link">
        <pose>0.8 0.3 0 0 0 0</pose>
        <inertial><mass>0.1</mass>
          <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
        </inertial>
      </link>
      <joint name="hand_brake_joint" type="revolute">
        <parent>chassis</parent>
        <child>hand_brake_link</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>0</lower><upper>0.8</upper></limit>
        </axis>
      </joint>

      <link name="fnr_switch_link">
        <pose>0.8 -0.3 0 0 0 0</pose>
        <inertial><mass>0.05</mass>
          <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
        </inertial>
      </link>
      <joint name="fnr_switch_joint" type="revolute">
        <parent>chassis</parent>
        <child>fnr_switch_link</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-0.3</lower><upper>0.3</upper></limit>
        </axis>
      </joint>

      <link name="fl_steer_link">
        <pose>0.8 0.6 -0.2 0 0 0</pose>
        <inertial><mass>1</mass>
          <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia>
        </inertial>
      </link>
      <joint name="fl_steer_joint" type="revolute">
        <parent>chassis</parent>
        <child>fl_steer_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-0.6</lower><upper>0.6</upper></limit>
        </axis>
      </joint>

      <link name="fl_wheel_link">
        <pose>0.8 0.6 -0.2 1.5708 0 0</pose>
        <inertial><mass>10</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia>
        </inertial>
        <collision name="fl_wheel_collision">
          <geometry><cylinder><radius>0.35</radius><length>0.2</length></cylinder></geometry>
        </collision>
      </link>
      <joint name="fl_wheel_joint" type="revolute">
        <parent>fl_steer_link</parent>
        <child>fl_wheel_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        </axis>
      </joint>

      <link name="fr_steer_link">
        <pose>0.8 -0.6 -0.2 0 0 0</pose>
        <inertial><mass>1</mass>
          <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia>
        </inertial>
      </link>
      <joint name="fr_steer_joint" type="revolute">
        <parent>chassis</parent>
        <child>fr_steer_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-0.6</lower><upper>0.6</upper></limit>
        </axis>
      </joint>

      <link name="fr_wheel_link">
        <pose>0.8 -0.6 -0.2 1.5708 0 0</pose>
        <inertial><mass>10</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia>
        </inertial>
        <collision name="fr_wheel_collision">
          <geometry><cylinder><radius>0.35</radius><length>0.2</length></cylinder></geometry>
        </collision>
      </link>
      <joint name="fr_wheel_joint" type="revolute">
        <parent>fr_steer_link</parent>
        <child>fr_wheel_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        </axis>
      </joint>

      <link name="bl_wheel_link">
        <pose>-0.8 0.6 -0.2 1.5708 0 0</pose>
        <inertial><mass>10</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia>
        </inertial>
        <collision name="bl_wheel_collision">
          <geometry><cylinder><radius>0.35</radius><length>0.2</length></cylinder></geometry>
        </collision>
      </link>
      <joint name="bl_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>bl_wheel_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        </axis>
      </joint>

      <link name="br_wheel_link">
        <pose>-0.8 -0.6 -0.2 1.5708 0 0</pose>
        <inertial><mass>10</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia>
        </inertial>
        <collision name="br_wheel_collision">
          <geometry><cylinder><radius>0.35</radius><length>0.2</length></cylinder></geometry>
        </collision>
      </link>
      <joint name="br_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>br_wheel_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        </axis>
      </joint>

      <plugin filename="DRCVehicleROSPlugin"
              name="drcsim_gazebo_ros_plugins::DRCVehicleROSPlugin">
        <gas_pedal>gas_pedal_joint</gas_pedal>
        <brake_pedal>brake_pedal_joint</brake_pedal>
        <steering_wheel>steering_wheel_joint</steering_wheel>
        <hand_brake>hand_brake_joint</hand_brake>
        <fnr_switch>fnr_switch_joint</fnr_switch>
        <front_left_wheel>fl_wheel_joint</front_left_wheel>
        <front_right_wheel>fr_wheel_joint</front_right_wheel>
        <back_left_wheel>bl_wheel_joint</back_left_wheel>
        <back_right_wheel>br_wheel_joint</back_right_wheel>
        <front_left_wheel_steering>fl_steer_joint</front_left_wheel_steering>
        <front_right_wheel_steering>fr_steer_joint</front_right_wheel_steering>
        <front_torque>500</front_torque>
        <back_torque>500</back_torque>
        <max_speed>20</max_speed>
      </plugin>
    </model>
  </world>
</sdf>
