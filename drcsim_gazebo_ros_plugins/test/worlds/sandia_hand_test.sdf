<?xml version="1.0"?>
<sdf version="1.9">
  <world name="sandia_hand_test">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>

    <model name="sandia_hand_test_model">
      <pose>0 0 1 0 0 0</pose>
      <static>false</static>

      <!-- No f*_j* joints on this model: exercises the plugin's "stumps"
           fallback (no hand joints found), which still stands up the ROS
           interface and publishes IMU/joint_states, just skips per-joint
           PID control and tactile processing. -->
      <link name="l_hand">
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
        </inertial>
      </link>

      <plugin filename="SandiaHandPlugin"
              name="drcsim_gazebo_ros_plugins::SandiaHandPlugin">
        <side>left</side>
      </plugin>
    </model>
  </world>
</sdf>
