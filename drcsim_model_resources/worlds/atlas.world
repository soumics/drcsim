<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="default">
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>1 -5 1 0 0 1.571</pose>
      </camera>
    </gui>
    <physics type="ode">
      <gravity>0 0 -9.81</gravity>
      <simbody>
        <accuracy>0.005</accuracy>
        <max_transient_velocity>0.005</max_transient_velocity>
        <contact>
          <stiffness>1e8</stiffness>
          <dissipation>20.0</dissipation>
        </contact>
      </simbody>
      <ode>
        <solver>
          <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
          <type>quick</type>
          <iters>200</iters>
          <sor>1.0</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.0</contact_surface_layer>
        </constraints>
      </ode>
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>
    <!-- Ported to gz-sim: this world predates Tier 2 (the plugins
         themselves), so it still needs the actual gz-sim system plugins
         spelled out explicitly (every hand-authored test world elsewhere
         in this migration does the same, rather than relying on gz-sim's
         own default-server-config fallback) and the plugin tags below
         updated from their Classic filenames/names to this port's
         GZ_ADD_PLUGIN_ALIAS names. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <!-- Pushes/kicks: /world/default/wrench (atlas_walking_demo's 'k' key)
         and the GUI's Apply Force/Torque tool. -->
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>

    <!-- A global light source. Inlined (was <include><uri>model://sun
         </uri></include>); that relied on Gazebo Fuel to resolve
         "sun"/"ground_plane" at load time, which fails with no internet
         access ("Unable to find uri[model://sun]"); every other
         hand-authored world in this migration is already fully
         self-contained for the same reason. Content matches gz-sim's
         own shipped empty.sdf template. -->
    <!-- A sky and soft ambient light for the showroom look (skin:=modern). -->
    <scene>
      <ambient>0.45 0.45 0.5 1</ambient>
      <background>0.72 0.82 0.95 1</background>
      <sky></sky>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.95 0.93 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.35 -0.8</direction>
    </light>
    <!-- A ground plane. Inlined for the same reason as the sun above. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <plugin filename="VRCPlugin" name="drcsim_gazebo_ros_plugins::VRCPlugin">
      <atlas>
        <model_name>atlas</model_name>
        <!-- "utorso" was Classic's older pin_link convention; some of
             the original repo's own later, VRC-Finals-era worlds
             (vrc_final_task11-15, vrc_task_3*, qual_task_2) already
             correctly use "pelvis" instead, matching the updated Atlas
             v5 kinematic tree used here (pelvis -> back_bkz -> ltorso
             -> back_bky -> mtorso -> back_bkx -> utorso, confirmed via
             atlas_v5_simple_shapes.urdf's own joint list; pelvis is the
             URDF's actual free-floating root, also confirmed by
             robot_state_publisher's own "root link pelvis" message).
             Pinning "utorso" here silently failed at spawn time (gz-sim
             logged "child link already has a parent joint of type
             [RevoluteJoint]"): the robot was never actually anchored
             during its supposedly-pinned bdi_stand startup phase, so
             VRCPlugin's stand-prep PID commands, with nothing to react
             against, flung the whole free-floating body around instead
             of holding it in place. The ~36 other Classic-era worlds
             still using "utorso" (atlas_cpu_lidar.world, most
             drc_practice_task_*/vrc_task_1*/vrc_task_2*/qual_task_1*/
             qual_task_3*/qual_task_4/vrc_final_task1-10, ...) likely
             have the same mismatch; left alone since none of them are
             wired into a launch file yet; fix when one is. -->
        <pin_link>pelvis</pin_link>
      </atlas>
      <drc_vehicle>
        <model_name>golf_cart</model_name>
        <seat_link>chassis</seat_link>
      </drc_vehicle>
      <drc_fire_hose>
        <fire_hose_model>fire_hose</fire_hose_model>
        <coupling_link>coupling</coupling_link>
        <standpipe_model>standpipe</standpipe_model>
        <spout_link>standpipe</spout_link>
        <thread_pitch>-1000</thread_pitch>
        <coupling_relative_pose>1.17038e-05 -0.125623 0.35 -0.0412152 -1.57078 1.61199</coupling_relative_pose>
      </drc_fire_hose>
    </plugin>
    <plugin filename="VRCScoringPlugin" name="drcsim_gazebo_ros_plugins::VRCScoringPlugin"/>
  </world>
</sdf>
