<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>joint_commands_gui</name>
  <version>3.1.0</version>
  <description>Per-joint slider GUI publishing osrf_msgs/JointCommands to Atlas.</description>
  <maintainer email="mfallon@osrfoundation.org">Maurice Fallon</maintainer>
  <license>BSD</license>
  <url type="website">http://gazebosim.org/wiki/DRC/joint_commands_gui</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>osrf_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-tk</exec_depend>

  <test_depend>ament_cmake_copyright</test_depend>
  <test_depend>ament_cmake_flake8</test_depend>
  <test_depend>ament_cmake_pep257</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
