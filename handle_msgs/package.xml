<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>handle_msgs</name>
  <version>3.1.0</version>
  <description>
    Definitions for all HANDLE topics and services
  </description>

  <maintainer email="hsu@osrfoundation.org">Ben Axelrod, John Hsu</maintainer>

  <license>BSD</license>

  <url type="website">http://ros.org/wiki/handle_msgs</url>
  <url type="bugtracker">https://bitbucket.org/osrf/drcsim/issues</url>
  <url type="repository">https://bitbucket.org/osrf/drcsim</url>

  <author>Ben Axelrod</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>std_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>rosidl_default_generators</build_depend>

  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>rclcpp</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
